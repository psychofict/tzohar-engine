# ── Tzohar site env ──────────────────────────────────────────────────────────
# Copy to .env.local for local dev; set the same in the Vercel project.

# Email — transactional (contact form) + newsletter/fan capture (Resend)
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Spotify catalog — only needed if the `music` module is enabled
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Analytics (all optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Search-console verification (all optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ── Membership: client-owned Stripe (provider="stripe" in src/config/membership)
# Required only when a build uses the Stripe membership provider. See docs/membership.md.
STRIPE_SECRET_KEY=
MEMBERSHIP_COOKIE_SECRET=          # random 32+ char string; signs the member cookie
# Stripe Price IDs per plan + interval (create the products/prices in Stripe first):
STRIPE_PRICE_INSIDER_MONTH=
STRIPE_PRICE_INSIDER_YEAR=
STRIPE_PRICE_STUDIO_MONTH=
STRIPE_PRICE_STUDIO_YEAR=
STRIPE_PRICE_PATRON_MONTH=
STRIPE_PRICE_PATRON_YEAR=

# ── Membership via the Ebenworks SSO hub (provider="hub") ────────────────────
# Only for builds whose membership provider is "hub". Drives SSO + hub checkout.
NEXT_PUBLIC_ACCOUNTS_URL=
ACCOUNTS_URL=

# ── CRM (/admin) — client-facing content management ──────────────────────────
# See docs/crm.md. Required for the CRM to work at all; without them the login
# screen reports "not configured" rather than failing as a wrong password.
CRM_PASSWORD=
CRM_SESSION_SECRET=          # 24+ random chars, signs the session cookie
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# Publishing target. With both of these set the CRM commits content to the repo
# (which triggers a Vercel rebuild); without them it writes to the local working
# tree, which is correct for dev and useless in production (read-only FS).
GITHUB_TOKEN=                # fine-grained PAT, Contents:write on this repo only
GITHUB_REPO=                 # e.g. your-org/your-site
GITHUB_BRANCH=main
# CRM_DRIVER=fs              # force a driver; omit to auto-detect
