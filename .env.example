# ── Tzohar site env ──────────────────────────────────────────────────────────
# Copy to .env.local for local dev; set the same in the Vercel project.

# Email — transactional (contact form) + newsletter/fan capture (Resend)
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
# Limits on the mail the forms send (TZS-4). With a Redis store they hold across instances; without
# one they count in each instance's memory. Upstash's names, or Vercel's Redis integration's
# KV_REST_API_URL / KV_REST_API_TOKEN. Mark the token Sensitive.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# MAIL_DAILY_CAP=60          # acknowledgements and confirm mails per UTC day; the owner's notes get 3x that
# MAIL_CONFIRM_SECRET=       # 24+ chars; seals sign-up confirm links. Default: derived from RESEND_API_KEY

# Spotify catalog — only needed if the `music` module is enabled
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Analytics (all optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Search-console verification (all optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ── Membership via the Ebenworks SSO hub (provider="hub") ────────────────────
# Only for builds whose membership provider is "hub". Drives SSO + hub checkout.
NEXT_PUBLIC_ACCOUNTS_URL=
ACCOUNTS_URL=

# ── CRM (/admin) — client-facing content management ──────────────────────────
# See docs/crm.md. Required for the CRM to work at all; without them the login
# screen reports "not configured" rather than failing as a wrong password.
CRM_PASSWORD=
CRM_SESSION_SECRET=          # 24+ random chars, signs the session cookie
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# Publishing target. With both of these set the CRM commits content to the repo
# (which triggers a Vercel rebuild); without them it writes to the local working
# tree, which is correct for dev and useless in production (read-only FS).
GITHUB_TOKEN=                # fine-grained PAT, Contents:write on this repo only
GITHUB_REPO=                 # e.g. ebenworks-systems/<slug>-site
GITHUB_BRANCH=main
# CRM_DRIVER=fs              # force a driver; omit to auto-detect

# Image uploads from /admin go to Cloudinary (engine 2.8.7), never into the repository.
# Signed on the server; mark all three as Sensitive on Vercel. Without them the site builds and
# runs, and the upload asks for an image address instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=tzohar-sites/<slug>/crm   # default: tzohar-sites/<site name>/crm
