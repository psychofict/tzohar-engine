# ── Tzohar site env ──────────────────────────────────────────────────────────
# Copy to .env.local for local dev; set the same in the Vercel project.

# Preview build (engine 2.8.17): 1 keeps the whole site out of search indexes (robots.txt, the robots
# tag, X-Robots-Tag). Read at BUILD time: set it for the build, and rebuild after changing it.
# TZOHAR_PREVIEW=1

# Email: the contact form's mail and the newsletter and Inner Circle confirm mails. They go through
# the company mail layer, useSend at https://mail-api.ebenworks.co over Amazon SES Seoul. The names
# are Resend's because the code uses the `resend` library and our useSend front answers Resend's
# request shape. RESEND_API_KEY is the site's own useSend key (us_...). RESEND_BASE_URL is the mail
# layer's address, which the code also uses when it is unset. The front answers send, batch and read only, so an
# Inner Circle audience add (RESEND_AUDIENCE_ID) is refused there and logged.
RESEND_API_KEY=
RESEND_BASE_URL=https://mail-api.ebenworks.co
RESEND_AUDIENCE_ID=
# Limits on the mail the forms send (TZS-4). With a Redis store they hold across instances; without
# one they count in each instance's memory. Upstash's names, or Vercel's Redis integration's
# KV_REST_API_URL / KV_REST_API_TOKEN. Mark the token Sensitive.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# MAIL_DAILY_CAP=1000        # acknowledgements and confirm mails per UTC day (default 1000); the owner's notes get 3x that
# MAIL_CONFIRM_SECRET=       # 24+ chars; seals sign-up confirm links. Default: derived from RESEND_API_KEY

# Spotify catalog — only needed if the `music` module is enabled
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Analytics (all optional). Vercel Web Analytics runs on every site; each one set here is
# loaded too and named in the privacy notice (src/lib/analytics.ts).
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_NAVER_ANALYTICS_ID=

# Search-console verification (all optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ── Membership via the Ebenworks SSO hub (provider="hub") ────────────────────
# Only for builds whose membership provider is "hub". Drives SSO + hub checkout.
NEXT_PUBLIC_ACCOUNTS_URL=
ACCOUNTS_URL=
# Server only, never NEXT_PUBLIC_: the hub's session-info key for this site's hub product, made
# by Ebenworks when the vault or a gated gallery goes on. Without it the server's membership
# checks count against the server address's hub limit (600 per 5 minutes).
HUB_SESSION_INFO_KEY=

# ── CRM (/admin) — client-facing content management ──────────────────────────
# See docs/crm.md. Required for the CRM to work at all; without them the login
# screen reports "not configured" rather than failing as a wrong password.
CRM_PASSWORD=
CRM_SESSION_SECRET=          # 24+ random chars, signs the session cookie
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# Publishing target. With both of these set the CRM commits content to the repo
# (which triggers a Vercel rebuild); without them it writes to the local working
# tree, which is correct for dev and useless in production (read-only FS).
GITHUB_TOKEN=                # fine-grained PAT, Contents:write on this repo only
GITHUB_REPO=                 # e.g. ebenworks-systems/<slug>-site
GITHUB_BRANCH=main
# CRM_DRIVER=fs              # force a driver; omit to auto-detect

# Image uploads from /admin go to Cloudinary (engine 2.8.7), never into the repository.
# Signed on the server; mark all three as Sensitive on Vercel. Without them the site builds and
# runs, and the upload asks for an image address instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# The CRM's upload folder, required for CRM uploads (Studio's CRM set-up writes it):
# CLOUDINARY_FOLDER=tzohar-sites/<slug>/crm-<vercel project id>

# Development only: a local Tzohar Studio origin (e.g. http://localhost:3001) that may frame this
# site and drive its live preview. A production build ignores it and accepts only
# https://studio.ebenworks.co (TZS-7).
NEXT_PUBLIC_TZOHAR_STUDIO_DEV_ORIGIN=
