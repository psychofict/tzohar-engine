{
  "name": "tzohar-sites",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "new-site": "node scripts/new-site.mjs",
    "generate-blur": "node scripts/generate-blur.mjs",
    "shots": "node scripts/shots.mjs",
    "module-paths": "node scripts/gen-module-paths.mjs",
    "module-paths:check": "node scripts/gen-module-paths.mjs --check",
    "check-messages": "node scripts/check-messages.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "quota": "node scripts/vercel-quota.mjs",
    "test:bibtex": "npx --yes tsx scripts/bibtex.test.ts",
    "test:tex": "npx --yes tsx scripts/tex.test.ts"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@vercel/analytics": "^2.0.1",
